POSTGRES_PORT=5436
APP_PORT=8080
API_KEY=dev_api_key
LOG_LEVEL=info
IDEMPOTENCY_LEASE_SECONDS=30

# API, relay, sweeper, reconciler: never the table owner.
DATABASE_URL=postgres://ledger_app:app_dev_pw@localhost:5436/wallet?sslmode=disable

# Migrations only: owns the database objects.
MIGRATE_DATABASE_URL=pgx5://ledger_migrator:migrator_dev_pw@localhost:5436/wallet?sslmode=disable&default_query_exec_mode=simple_protocol

# Redpanda / Kafka
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ledger.events.v1
KAFKA_CONSUMER_GROUP=ledger-consumer-demo

# Outbox relay
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_BACKOFF=30s

# Hold expiry worker
HOLD_SWEEP_INTERVAL=5s
HOLD_SWEEP_BATCH_SIZE=100

# Reconciliation worker
RECONCILER_POLL_INTERVAL=5s
